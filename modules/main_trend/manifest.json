{
  "id": "vflow.user.main_trend",
  "name": "主趋势线监控",
  "description": "通达信主趋势线 EMA(EMA(CLOSE,10),10)：本根大于上一根为红（买），否则为绿（卖）。支持 5/15/30/60 分钟、日线、周线，三源兜底，输出绿转红、红转绿、无变化三种结果。",
  "category": "网络",
  "author": "vFlow 用户模块",
  "version": "1.2.0",
  "summary": "{name} {codes} · {period}",
  "inputs": [
    {
      "id": "codes",
      "name": "监控标的（每行一个）",
      "type": "string",
      "defaultValue": "sh600000",
      "magic_variable": true
    },
    {
      "id": "period",
      "name": "周期",
      "type": "enum",
      "defaultValue": "日线",
      "options": [
        "5分钟",
        "15分钟",
        "30分钟",
        "60分钟",
        "日线",
        "周线"
      ],
      "magic_variable": false
    },
    {
      "id": "source",
      "name": "数据源",
      "type": "enum",
      "defaultValue": "auto",
      "options": [
        "auto",
        "tencent",
        "eastmoney",
        "sina"
      ],
      "magic_variable": false
    },
    {
      "id": "only_changed",
      "name": "仅输出变化标的",
      "type": "boolean",
      "defaultValue": false,
      "magic_variable": false
    }
  ],
  "outputs": [
    {
      "id": "status",
      "name": "结果状态",
      "type": "string"
    },
    {
      "id": "has_green_to_red",
      "name": "是否出现绿转红",
      "type": "boolean"
    },
    {
      "id": "has_red_to_green",
      "name": "是否出现红转绿",
      "type": "boolean"
    },
    {
      "id": "green_to_red",
      "name": "绿转红标的",
      "type": "list"
    },
    {
      "id": "red_to_green",
      "name": "红转绿标的",
      "type": "list"
    },
    {
      "id": "details",
      "name": "逐标的明细",
      "type": "list"
    },
    {
      "id": "summary",
      "name": "汇总文本",
      "type": "string"
    },
    {
      "id": "source",
      "name": "实际数据源",
      "type": "string"
    },
    {
      "id": "failed",
      "name": "取数失败的标的",
      "type": "string"
    }
  ]
}
